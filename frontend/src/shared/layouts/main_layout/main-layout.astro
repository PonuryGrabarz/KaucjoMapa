---
import "./main-layout.sass";

import { SITE_URL } from "astro:env/server";
import { ClientRouter } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
    canonical?: string | URL;
    image?: string | URL | false;
    imageAlt?: string;
    imageWidth?: number;
    imageHeight?: number;
    imageType?: string;
    noIndex?: boolean;
    openGraphType?: "website" | "article";
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE_NAME = "KaucjoMapa";

const DEFAULT_TITLE = "KaucjoMapa – mapa punktów zwrotu opakowań kaucyjnych";

const DEFAULT_DESCRIPTION =
    "Znajdź najbliższy punkt zwrotu butelek i puszek objętych systemem kaucyjnym. KaucjoMapa pomaga szybko zlokalizować automat lub punkt odbioru opakowań.";

const {
    title = DEFAULT_TITLE,
    description = DEFAULT_DESCRIPTION,
    canonical,
    image = "/social-card.png",
    imageAlt = "KaucjoMapa – mapa punktów zwrotu opakowań kaucyjnych",
    imageWidth = 1200,
    imageHeight = 630,
    imageType = "image/png",
    noIndex = false,
    openGraphType = "website",
    structuredData,
} = Astro.props;

const baseUrl = SITE_URL ? new URL(SITE_URL) : Astro.site ?? Astro.url;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, baseUrl);
canonicalUrl.hash = "";

if (canonical === undefined) canonicalUrl.search = "";

const siteUrl = new URL(import.meta.env.BASE_URL, baseUrl);
siteUrl.hash = "";
siteUrl.search = "";

const imageUrl = image ? new URL(image, baseUrl) : undefined;

const robots = noIndex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const defaultStructuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${siteUrl.href}#website`,
            url: siteUrl.href,
            name: SITE_NAME,
            description: DEFAULT_DESCRIPTION,
            inLanguage: "pl-PL",
        },
        {
            "@type": "WebPage",
            "@id": `${canonicalUrl.href}#webpage`,
            url: canonicalUrl.href,
            name: title,
            description,
            inLanguage: "pl-PL",
            isPartOf: {
                "@id": `${siteUrl.href}#website`,
            },
            ...(imageUrl && {
                primaryImageOfPage: {
                    "@type": "ImageObject",
                    url: imageUrl.href,
                    contentUrl: imageUrl.href,
                    width: imageWidth,
                    height: imageHeight,
                    caption: imageAlt,
                },
            }),
        },
    ],
};

const serializedStructuredData = JSON.stringify(
    structuredData ?? defaultStructuredData,
).replace(/</g, "\\u003c");
---

<html lang="pl">
    <head>
        <meta charset="utf-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="application-name" content={SITE_NAME} />
        <meta name="theme-color" content="#1aa149" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <meta name="googlebot" content={robots} />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content="pl_PL" />
        <meta property="og:type" content={openGraphType} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />

        <meta
            name="twitter:card"
            content={imageUrl ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        {
            imageUrl && (
                <>
                    <meta property="og:image" content={imageUrl} />
                    {imageUrl.protocol === "https:" && (
                        <meta
                            property="og:image:secure_url"
                            content={imageUrl}
                        />
                    )}
                    <meta property="og:image:type" content={imageType} />
                    <meta
                        property="og:image:width"
                        content={String(imageWidth)}
                    />
                    <meta
                        property="og:image:height"
                        content={String(imageHeight)}
                    />
                    <meta property="og:image:alt" content={imageAlt} />
                    <meta name="twitter:image" content={imageUrl} />
                    <meta name="twitter:image:alt" content={imageAlt} />
                </>
            )
        }

        <script
            is:inline
            type="application/ld+json"
            set:html={serializedStructuredData}
        />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        <ClientRouter />

        <slot name="head" />
    </head>

    <body transition:name="root">
        <slot />
    </body>
</html>
