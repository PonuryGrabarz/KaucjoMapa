---
import type { HTMLAttributes } from 'astro/types';

import Styles from './input.module.sass';

type NativeInputProps = HTMLAttributes<'input'>;

interface Props extends Omit<NativeInputProps, 'class' | 'type'> {
  icon?: string;
  label?: string;
  labelHidden?: boolean;
  type?: NativeInputProps['type'];
}

const {
  icon,
  type = 'text',
  placeholder,
  value,
  disabled = false,
  required = false,
  name,
  id,
  label,
  labelHidden = false,
  'aria-label': ariaLabelFromProps,
  ...inputAttributes
} = Astro.props;

const inputId =
  id ?? (label && !labelHidden ? `km-input-${Math.random().toString(36).slice(2, 10)}` : undefined);
const ariaLabel = ariaLabelFromProps ?? (labelHidden ? label : undefined);
const hasTrailingIcon = Astro.slots.has('trailing-icon');
---

<km-input class:list={Styles['input']} disabled={disabled}>
  {
    label && !labelHidden && (
      <label class:list={Styles['input__label']} for={inputId}>
        {label}
      </label>
    )
  }
  <div class:list={Styles['input__control']}>
    {icon && <iconify-icon icon={icon} class:list={Styles['input__icon']} aria-hidden="true" />}
    <input
      {...inputAttributes}
      class:list={Styles['input__field']}
      id={inputId}
      name={name}
      type={type}
      placeholder={placeholder}
      value={value}
      disabled={disabled}
      required={required}
      aria-label={ariaLabel}
    />
    {
      hasTrailingIcon && (
        <span class:list={Styles['input__trailing-icon']}>
          <slot name="trailing-icon" />
        </span>
      )
    }
  </div>
</km-input>

<script src="./input.ts"></script>
