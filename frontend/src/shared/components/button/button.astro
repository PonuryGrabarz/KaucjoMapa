---
import type { HTMLAttributes } from 'astro/types';

import Styles from './button.module.sass';

type NativeButtonProps = HTMLAttributes<'button'>;

type ButtonVariant = 'contained' | 'outlined' | 'text';
type ButtonColor = 'primary' | 'danger';
type ButtonSize = 'small' | 'medium' | 'large';

interface Props extends Omit<NativeButtonProps, 'class'> {
  color?: ButtonColor;
  endIcon?: string;
  fullWidth?: boolean;
  icon?: string;
  size?: ButtonSize;
  startIcon?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: ButtonVariant;
}

const {
  variant = 'contained',
  color = 'primary',
  size = 'medium',
  disabled = false,
  fullWidth = false,
  type = 'button',
  icon,
  startIcon,
  endIcon,
  ...buttonAttributes
} = Astro.props;

const isDisabled = disabled === true || disabled === 'true' || disabled === '';
const ariaDisabled = isDisabled ? 'true' : 'false';
const startIconName = startIcon ?? icon;
const startIconValue = startIconName ?? '';
const endIconValue = endIcon ?? '';
const hasStartIconSlot = Astro.slots.has('start-icon');
const hasEndIconSlot = Astro.slots.has('end-icon');
const hasDefaultSlot = Astro.slots.has('default');
const hasStartIcon = hasStartIconSlot || Boolean(startIconName);
const hasEndIcon = hasEndIconSlot || Boolean(endIcon);
const isIconOnly = !hasDefaultSlot && (hasStartIcon || hasEndIcon);
---

<km-button
  class:list={Styles['button']}
  data-variant={variant}
  data-color={color}
  data-size={size}
  data-full-width={fullWidth ? 'true' : undefined}
  data-icon-only={isIconOnly ? 'true' : undefined}
  disabled={isDisabled ? true : undefined}
>
  <button
    {...buttonAttributes}
    class:list={Styles['button__control']}
    type={type}
    disabled={isDisabled}
    aria-disabled={ariaDisabled}
  >
    {
      hasStartIcon && (
        <span class:list={[Styles['button__icon'], Styles['button__icon--start']]} aria-hidden="true">
          {hasStartIconSlot ? <slot name="start-icon" /> : <iconify-icon icon={startIconValue} />}
        </span>
      )
    }
    {
      hasDefaultSlot && (
        <span class:list={Styles['button__label']}>
          <slot />
        </span>
      )
    }
    {
      hasEndIcon && (
        <span class:list={[Styles['button__icon'], Styles['button__icon--end']]} aria-hidden="true">
          {hasEndIconSlot ? <slot name="end-icon" /> : <iconify-icon icon={endIconValue} />}
        </span>
      )
    }
  </button>
</km-button>

<script src="./button.ts"></script>
