---
import Styles from "./topbar.module.sass";
---

<header class={Styles["topbar"]}>
    <a class={Styles["topbar__brand"]} href="/">
        <img
            class={Styles["topbar__logo"]}
            src="/favicon.svg"
            alt="Logo KaucjoMapa"
            width="36"
            height="36"
            decoding="async"
        />

        <span class={Styles["topbar__title"]}>KaucjoMapa</span>
    </a>
</header>
