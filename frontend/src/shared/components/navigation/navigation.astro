---
import NavItem from "@shared/components/nav_item/nav-item.svelte";
import Styles from "./navigation.module.sass";

import { accountItems, guestItems, isPathActive, mainItems } from "@shared/helpers/navigation-links";
import { normalizePathname } from "@shared/helpers/path";

interface Props {
	unreadCount?: number;
}

const { unreadCount = 0 } = Astro.props;

const pathname = normalizePathname(Astro.url.pathname);

const isUserLoggedIn = Astro.locals.session != null;

const MAIN_LABEL_ID = "navigation-main-label";
const ACCOUNT_LABEL_ID = "navigation-account-label";
---

<nav class={Styles["navigation"]} aria-label="Nawigacja główna" transition:name="navigation">
  <div class={Styles["navigation__container"]}>
    <span class={Styles["navigation__container__label"]} id={MAIN_LABEL_ID}>Główne</span>

    <ul class={Styles["navigation__container__list"]} aria-labelledby={MAIN_LABEL_ID}>
      {
        mainItems.map((item) => (
          <li>
            <NavItem
              href={item.href}
              label={item.label}
              icon={item.icon}
              activeIcon={item.activeIcon}
              active={isPathActive(pathname, item.href)}
            />
          </li>
        ))
      }
    </ul>

    <span class={Styles["navigation__container__spacer"]} aria-hidden="true"></span>

    {
      isUserLoggedIn ? (
        <>
          <span class={Styles["navigation__container__label"]} id={ACCOUNT_LABEL_ID}>
            Konto i aktywność
          </span>

          <ul class={Styles["navigation__container__list"]} aria-labelledby={ACCOUNT_LABEL_ID}>
            {accountItems.map((item) => {
              const shared = {
                href: item.href,
                label: item.label,
                icon: item.icon,
                activeIcon: item.activeIcon,
                active: isPathActive(pathname, item.href),
              };

              return (
                <li>
                  {item.href === "/powiadomienia" ? (
                    <NavItem client:load liveBadge badgeCount={unreadCount} {...shared} />
                  ) : (
                    <NavItem {...shared} />
                  )}
                </li>
              );
            })}
          </ul>
        </>
      ) : (
        <ul class={Styles["navigation__container__list"]} aria-label="Konto">
          {guestItems.map((item) => (
            <li>
              <NavItem
                href={item.href}
                label={item.label}
                icon={item.icon}
                activeIcon={item.activeIcon}
                active={isPathActive(pathname, item.href, item.activeFor)}
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</nav>
