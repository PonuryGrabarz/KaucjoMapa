---
import Styles from "./navigation.module.sass";
import NavigationSheet from "./navigation-sheet";
import IconifyIcon from "@components/iconify_icon/iconify-icon";

interface Props {
    links: Link[];
    class?: string;
    ariaLabel?: string;
}

export type Link = {
    icon: string;
    href: string;
    label: string;
};

const { links, class: className, ariaLabel = "Główna nawigacja" } = Astro.props;

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";

const currentPath = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
    const targetUrl = new URL(href, Astro.url);

    if (targetUrl.origin !== Astro.url.origin) return false;
    if (targetUrl.hash || href.endsWith("#")) return false;

    const targetPath = normalizePath(targetUrl.pathname);

    return (
        currentPath === targetPath ||
        (targetPath !== "/" && currentPath.startsWith(`${targetPath}/`))
    );
};

const linksWithState = links.map((link) => ({
    ...link,
    active: isActive(link.href),
}));

const hasMobileOverflow = links.length > 4;

const mobilePrimaryCount = hasMobileOverflow ? 3 : links.length;

const sheetLinks = linksWithState.slice(mobilePrimaryCount);

const sheetActive = sheetLinks.some(({ active }) => active);
---

<nav class:list={[Styles["navigation"], className]} aria-label={ariaLabel}>
    <ul class:list={[Styles["navigation__list"]]}>
        {
            linksWithState.map(({ href, label, icon, active }, index) => {
                const mobileOverflow =
                    hasMobileOverflow && index >= mobilePrimaryCount;

                return (
                    <li
                        class:list={[
                            Styles["navigation__item"],
                            {
                                [Styles["navigation__item--mobile-overflow"]]:
                                    mobileOverflow,
                            },
                        ]}
                        data-mobile-overflow={
                            mobileOverflow ? "true" : undefined
                        }
                    >
                        <a
                            href={href}
                            class:list={[
                                Styles["navigation__link"],
                                {
                                    [Styles["navigation__link--active"]]:
                                        active,
                                },
                            ]}
                            aria-current={active ? "page" : undefined}
                            data-active={active ? "true" : undefined}
                        >
                            <span
                                class={Styles["navigation__indicator"]}
                                aria-hidden="true"
                            >
                                <IconifyIcon icon={icon} />
                            </span>

                            <span class={Styles["navigation__label"]}>
                                {label}
                            </span>
                        </a>
                    </li>
                );
            })
        }

        {
            hasMobileOverflow && (
                <li
                    class:list={[Styles["navigation__item"]]}
                    data-mobile-more="true"
                >
                    <NavigationSheet
                        client:load
                        links={sheetLinks}
                        active={sheetActive}
                    />
                </li>
            )
        }
    </ul>
</nav>
