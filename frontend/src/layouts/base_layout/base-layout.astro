---
import "./global.sass";

import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

export interface Props {
      title: string;
      description: string;
      noindex?: boolean;
      bareTitle?: boolean;
}

const { title, description, noindex = false, bareTitle = false } = Astro.props;

const pageTitle = bareTitle ? title : `${title} · KaucjoMapa`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL("/social-card.png", Astro.site).toString();
---

<!doctype html>
<html lang="pl">
      <head>
              <meta charset="UTF-8" />
              <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
              <meta name="theme-color" content="#f5faf6" />
              <meta name="color-scheme" content="light" />

              <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
              <link rel="icon" href="/favicon.ico" sizes="32x32" />

              <title>{pageTitle}</title>
              <meta name="description" content={description} />
              {/* Brak canonicala przy noindex — na 404 wskazywałby na adres,
                  którego nie ma, a canonical i noindex to sprzeczne sygnały. */}
              {noindex
                ? <meta name="robots" content="noindex, nofollow" />
                : <link rel="canonical" href={canonicalUrl} />}

              <meta property="og:site_name" content="KaucjoMapa" />
              <meta property="og:locale" content="pl_PL" />
              <meta property="og:type" content="website" />
              <meta property="og:title" content={pageTitle} />
              <meta property="og:description" content={description} />
              <meta property="og:url" content={canonicalUrl} />
              <meta property="og:image" content={socialImage} />
              <meta property="og:image:width" content="1200" />
              <meta property="og:image:height" content="630" />
              <meta property="og:image:alt" content="KaucjoMapa — mapa punktów kaucyjnych w Polsce" />

              <meta name="twitter:card" content="summary_large_image" />

              <Font cssVariable="--font-ui" preload />
              <ClientRouter />
      </head>

      <body>
              <a class="skip-link" href="#main">Przejdź do treści</a>
              
              <slot />
      </body>
</html>
