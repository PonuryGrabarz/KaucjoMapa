---
import Styles from "./point-list-loading-view.module.sass";

const SKELETON_CARDS = 20;
---

<section class:list={Styles["point-list-loading"]} aria-busy="true">
  <div class:list={Styles["point-list-loading__header"]}>
    <div class:list={Styles["point-list-loading__header__form"]}>
      <span class:list={Styles["point-list-loading__header__form__search"]}></span>

      <div class:list={Styles["point-list-loading__header__form__actions"]}>
        <span></span>

        <span></span>

        <span></span>
      </div>
    </div>

    <div class:list={Styles["point-list-loading__header__status"]}>
      <span></span>
    </div>
  </div>

  <div class:list={Styles["point-list-loading__items"]} role="status">
    <span class="visually-hidden">Wczytywanie listy punktów zwrotu</span>

    <ul aria-hidden="true">
      {
        Array.from({ length: SKELETON_CARDS }, (_, index) => (
          <li>
            <div class:list={Styles["point-list-loading__items__card"]}>
              <div class:list={Styles["point-list-loading__items__card__identity"]}>
                <span class:list={Styles["point-list-loading__items__card__identity__pin"]}></span>

                <div class:list={Styles["point-list-loading__items__card__identity__heading"]}>
                  <span></span>

                  <span></span>
                </div>
              </div>

              <div class:list={Styles["point-list-loading__items__card__row"]}>
                <span></span>

                <span></span>
              </div>

              <div class:list={Styles["point-list-loading__items__card__lines"]}>
                <span></span>

                <span></span>

                <span></span>
              </div>

              <div class:list={Styles["point-list-loading__items__card__chips"]}>
                <span></span>

                <span></span>

                <span></span>
              </div>
            </div>

            <span class="visually-hidden">Pozycja {index + 1}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
