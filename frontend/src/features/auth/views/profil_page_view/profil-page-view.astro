---
import Styles from "./profil-page-view.module.sass";
import ProfileSettings from "../../components/profile_settings/profile-settings.astro";
import ProfileSummary from "../../components/profile_summary/profile-summary.astro";

import { profileStats } from "../../lib/profile-mock-data";

interface Props {
  user: App.SessionUser;
}

const { user } = Astro.props;
---

<section
  class={Styles["profil-page"]}
  aria-labelledby="profil-page-title"
  aria-describedby="profil-page-description"
>
  <div class={Styles["profil-page__content"]}>
    <ProfileSummary user={user} stats={profileStats} />
    <ProfileSettings />
  </div>
</section>