---
import Styles from "./profile-settings.module.sass";
import LogoutButton from "../logout_button/logout-button";
---

<section class={Styles["profile-settings"]} aria-labelledby="profile-settings-title">
  <header class={Styles["profile-settings__header"]}>
    <h2 id="profile-settings-title">Ustawienia konta</h2>
    <p>Zakończ bezpiecznie bieżącą sesję na tym urządzeniu.</p>
  </header>

  <LogoutButton client:load />
</section>
