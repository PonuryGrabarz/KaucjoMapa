---
import Styles from "./alerts-page-view.module.sass";
import AlertsPanel from "../../components/alerts_panel/alerts-panel";

import { alertItems } from "../../lib/alerts-mock-data";
---

<section
    class={Styles["alerts-page"]}
    aria-labelledby="alerts-page-title"
    aria-describedby="alerts-page-description"
>
    <h1 id="alerts-page-title" class={Styles["alerts-page__title"]}>
        Powiadomienia o punktach zwrotu
    </h1>

    <p id="alerts-page-description" class={Styles["alerts-page__description"]}>
        Sprawdź najnowsze informacje o obserwowanych punktach zwrotu opakowań kaucyjnych.
    </p>

    <AlertsPanel items={alertItems} client:load />
</section>