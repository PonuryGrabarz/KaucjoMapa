---
import Styles from "./home-page-view.module.sass";
import Map from "../../components/map/map";
import Toolbar from "../../components/toolbar/toolbar";

import { apiClient } from "@api/api-client-factory";
import { GetMapPointsRequest } from "@api/requests";

const getMapPointsRequestResult = GetMapPointsRequest.create();

if (getMapPointsRequestResult.isError) {
    throw getMapPointsRequestResult.firstError;
}

const getMapPointsResponseResult = await apiClient.send(getMapPointsRequestResult.value);

if (getMapPointsResponseResult.isError) {
    throw getMapPointsResponseResult.firstError;
}

const initialReturnPoints = getMapPointsResponseResult.value;
---

<section
    class:list={Styles["home-page-view"]}
    aria-labelledby="return-points-page-title"
>
    <h1
        id="return-points-page-title"
        class={Styles["home-page-view__title"]}
    >
        Mapa punktów zwrotu opakowań kaucyjnych
    </h1>

    <Toolbar client:load />

    <Map client:load initialReturnPoints={initialReturnPoints} />
</section>
