---
import Styles from "./point-list-item.module.sass";

import type { MapPointDetails } from "@api/responses/get-map-points-response";

interface Props {
    point: MapPointDetails;
}

const STATUS_META: Readonly<Record<MapPointDetails["currentStatus"], { label: string }>> = {
    dostepny: { label: "Dostępny" },
    zapelniony: { label: "Zapełniony" },
    nieczynny: { label: "Nieczynny" },
    awaria: { label: "Awaria" },
    brak_informacji: { label: "Brak informacji" },
    do_weryfikacji: { label: "Do weryfikacji" },
};

const { point } = Astro.props;

const name = point.name?.trim() || point.shortName;

const address = point.address?.trim();

const openingHours = point.openingHours?.trim();
const description = point.description?.trim();

const status = Object.hasOwn(STATUS_META, point.currentStatus)
    ? point.currentStatus
    : "brak_informacji";

const packagingOptions = [
    { available: Boolean(point.pet), label: "PET" },
    { available: Boolean(point.can), label: "Puszki" },
    { available: Boolean(point.glass), label: "Szkło" },
];

const getOpeningState = (hours: string | undefined): boolean | undefined => {
    if (!hours) return undefined;

    const normalizedHours = hours.toLocaleLowerCase("pl-PL");

    if (/całodobowo/u.test(normalizedHours)) return true;
    if (/zamknięte/u.test(normalizedHours)) return false;

    const match = hours.match(
        /^(\d{1,2})[:.](\d{2})(?::\d{2})?\s*[-–—]\s*(\d{1,2})[:.](\d{2})(?::\d{2})?$/u,
    );

    if (!match) return undefined;

    const [, openingHour, openingMinute, closingHour, closingMinute] = match;
    const openingTime = Number(openingHour) * 60 + Number(openingMinute);
    const closingTime = Number(closingHour) * 60 + Number(closingMinute);

    if (openingTime === closingTime) return undefined;

    const currentTimeParts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Warsaw",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
    }).formatToParts(new Date());
    const currentHour = Number(currentTimeParts.find(({ type }) => type === "hour")?.value);
    const currentMinute = Number(currentTimeParts.find(({ type }) => type === "minute")?.value);
    const currentTime = currentHour * 60 + currentMinute;

    return closingTime > openingTime
        ? currentTime >= openingTime && currentTime < closingTime
        : currentTime >= openingTime || currentTime < closingTime;
};

const isOpenNow = getOpeningState(openingHours);

const pointUrl = `/?${new URLSearchParams({ selectedPointId: point.returnPointId })}`;
---

<li class={Styles["point-list-item"]}>
    <a
        class={Styles["point-list-item__link"]}
        href={pointUrl}
        aria-label={`Pokaż punkt ${name} na mapie`}
    >
        <article class={Styles["point-list-item__card"]}>
            <header class={Styles["point-list-item__header"]}>
                <div class={Styles["point-list-item__identity"]}>
                    <span
                        class={Styles["point-list-item__brand"]}
                        style={{ "--brand-bg": point.bgColor, "--brand-color": point.textColor }}
                        aria-hidden="true"
                    >
                        {point.shortName}
                    </span>

                    <div class={Styles["point-list-item__heading"]}>
                        <h2>{name}</h2>
                        {address && <address>{address}</address>}
                    </div>
                </div>

                <span class={Styles["point-list-item__status"]} data-status={status}>
                    {STATUS_META[status].label}
                </span>
            </header>

            <div class={Styles["point-list-item__details"]}>
                {description && (
                    <p class={Styles["point-list-item__description"]}>{description}</p>
                )}

                {openingHours && (
                    <div class={Styles["point-list-item__opening-hours"]}>
                        <p>
                            <span>Godziny otwarcia</span>
                            <strong>{openingHours}</strong>
                        </p>

                        {isOpenNow !== undefined && (
                            <span
                                class={Styles["point-list-item__open-state"]}
                                data-open={isOpenNow ? "true" : "false"}
                            >
                                {isOpenNow ? "Otwarte teraz" : "Zamknięte teraz"}
                            </span>
                        )}
                    </div>
                )}

                <div class={Styles["point-list-item__packaging"]}>
                    <span class={Styles["point-list-item__packaging-label"]}>Opakowania:</span>
                    <ul aria-label="Obsługiwane rodzaje opakowań">
                        {packagingOptions.map(({ available, label }) => (
                            <li
                                data-available={available ? "true" : "false"}
                                aria-label={`${label}: ${available ? "przyjmowane" : "nieprzyjmowane"}`}
                            >
                                <span>{label}</span>
                                <span aria-hidden="true">{available ? "✓" : "×"}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>

            <footer class={Styles["point-list-item__footer"]} aria-hidden="true">
                <span>Zobacz na mapie</span>
                <span>→</span>
            </footer>
        </article>
    </a>
</li>
