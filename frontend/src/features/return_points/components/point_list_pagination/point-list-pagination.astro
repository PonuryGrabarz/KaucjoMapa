---
import Styles from "./point-list-pagination.module.sass";

import Button from "@components/button/button";

interface Props {
    page: number;
    totalPages: number;
    searchParams?: string;
}

const { page, totalPages, searchParams = "" } = Astro.props;

const hasPreviousPage = page > 1;
const hasNextPage = page < totalPages;

const buildHref = (targetPage: number): string => {
    const params = new URLSearchParams(searchParams);

    if (targetPage > 1) {
        params.set("page", String(targetPage));
    } else {
        params.delete("page");
    }

    const query = params.toString();
    return `/punkty${query ? `?${query}` : ""}`;
};

const previousClass = [
    Styles["point-list-pagination__link"],
    Styles["point-list-pagination__previous"],
].join(" ");
const nextClass = [
    Styles["point-list-pagination__link"],
    Styles["point-list-pagination__next"],
].join(" ");
---

<nav class={Styles["point-list-pagination"]} aria-label="Stronicowanie listy punktów">
    {hasPreviousPage ? (
        <Button
            client:load
            class={previousClass}
            href={buildHref(page - 1)}
            rel="prev"
            variant="outlined"
            startIcon="mdi:arrow-left"
        >
            Poprzednia
        </Button>
    ) : (
        <Button
            client:load
            class={previousClass}
            type="button"
            variant="outlined"
            startIcon="mdi:arrow-left"
            disabled
        >
            Poprzednia
        </Button>
    )}

    <span class={Styles["point-list-pagination__current"]} aria-current="page">
        Strona {page} z {totalPages}
    </span>

    {hasNextPage ? (
        <Button
            client:load
            class={nextClass}
            href={buildHref(page + 1)}
            rel="next"
            variant="outlined"
            endIcon="mdi:arrow-right"
        >
            Następna
        </Button>
    ) : (
        <Button
            client:load
            class={nextClass}
            type="button"
            variant="outlined"
            endIcon="mdi:arrow-right"
            disabled
        >
            Następna
        </Button>
    )}
</nav>
