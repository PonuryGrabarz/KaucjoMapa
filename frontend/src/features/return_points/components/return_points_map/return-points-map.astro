---
import MapFabButton from '../map_fab_button/map-fab-button.astro';
import Styles from './return-points-map.module.sass';

const { initialReturnPoints } = Astro.props;
---

<return-points-map class:list={Styles['return-points-map']}
                   data-initial-return-points={JSON.stringify(initialReturnPoints)}>
  <div data-map-container />

  <MapFabButton />
</return-points-map>

<script src="./return-points-map.ts" />
