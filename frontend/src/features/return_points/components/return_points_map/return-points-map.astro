---
import MapPin from '../map_pin/map-pin.astro';
import Styles from './return-points-map.module.sass';

import { apiClient } from '@shared/api/api-client-factory';
import { GetMapPointsRequest } from '@shared/api/requests';

const initialReturnPoints = await apiClient.send<GetMapPointsRequest>(new GetMapPointsRequest());
---

<MapPin />

<return-points-map class:list={Styles['return-points-map']}>
  <div data-map-container />
</return-points-map>

<script is:inline define:vars={{ initialReturnPoints }}>
  window.initialReturnPoints = initialReturnPoints;
</script>

<script src="./return-points-map.ts" />
