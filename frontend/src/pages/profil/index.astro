---
import Topbar from "@components/topbar/topbar.astro";
import AppLayout from "@layouts/app_layout/app-layout.astro";
import MainLayout from "@layouts/main_layout/main-layout.astro";
import ProfilPageView from "@features/auth/views/profil_page_view/profil-page-view.astro";

const user = (await Astro.session?.get("user"))!;
---

<MainLayout
    title="Profil użytkownika | KaucjoMapa"
    description="Sprawdź dane swojego konta, statystyki zwrotów opakowań kaucyjnych i ustawienia sesji w KaucjoMapie."
    canonical="/profil"
    noIndex
>
    <AppLayout>
        <Topbar title="Profil" />

        <ProfilPageView user={user} />
    </AppLayout>
</MainLayout>
