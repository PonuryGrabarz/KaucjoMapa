---
import AppLayout from "@layouts/app_layout/app-layout.astro";
import PointListPageView from "@features/points_list/views/point_list_page_view/point-list-page-view.astro";
import PointListLoadingView from "@features/points_list/views/point_list_loading_view/point-list-loading-view.astro";

import { hasActiveFilters, parseListFilters } from "@features/points_list/list-filters";

const filters = parseListFilters(Astro.url.searchParams);

const isFilteredView = hasActiveFilters(filters) || filters.page > 1;

const title = filters.page > 1 ? `Punkty — strona ${filters.page}` : "Punkty";
---

<AppLayout
  {title}
  description="Lista punktów zwrotu opakowań kaucyjnych w Polsce — butelkomaty, sklepy i punkty skupu."
  noindex={isFilteredView}
>
  <div class="visually-hidden">
    <h1>Lista punktów zwrotu opakowań kaucyjnych</h1>

    <p>
      Przeglądaj butelkomaty, sklepy i punkty skupu przyjmujące butelki PET, puszki i butelki
      szklane. Filtruj po statusie, typie punktu, rodzaju opakowań i formie zwrotu kaucji.
    </p>
  </div>

  <PointListPageView server:defer search={Astro.url.search}>
    <PointListLoadingView slot="fallback" />
  </PointListPageView>
</AppLayout>
