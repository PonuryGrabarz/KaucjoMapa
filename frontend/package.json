{
	"name": "kaucjomapa-frontend",
	"author": "Eviraznva",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "NODE_EXTRA_CA_CERTS=../.docker/nginx-proxy-manager/certs/kaucjo-mapa-ca.crt astro dev",
		"build": "astro build",
		"preview": "NODE_EXTRA_CA_CERTS=../.docker/nginx-proxy-manager/certs/kaucjo-mapa-ca.crt API_URL=https://kaucjo-mapa.pl/api astro preview",
		"astro": "astro",
		"check": "astro check",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"lint": "eslint . && stylelint \"src/**/*.sass\" --allow-empty-input",
		"lint:fix": "eslint . --fix && stylelint \"src/**/*.sass\" --fix --allow-empty-input",
		"format": "prettier . --write && stylelint \"src/**/*.sass\" --fix --allow-empty-input",
		"format:check": "prettier . --check"
	},
	"dependencies": {
		"@astrojs/node": "^11.0.2",
		"@astrojs/sitemap": "^3.7.0",
		"@astrojs/svelte": "^9.0.1",
		"astro": "^7.1.3",
		"echarts": "^6.1.0",
		"emittery": "^2.0.0",
		"ky": "^2.0.2",
		"maplibre-gl": "^6.0.0",
		"sass": "^1.102.0",
		"svelte": "^5.56.8",
		"typescript": "^6.0.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@eslint/js": "^9.39.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^25.0.10",
		"eslint": "^9.39.2",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.4.0",
		"jsdom": "^29.1.1",
		"postcss": "^8.5.6",
		"postcss-sass": "^0.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"svelte-check": "^4.7.3",
		"svelte-preprocess": "^6.0.5",
		"typescript-eslint": "^8.65.0"
	}
}
