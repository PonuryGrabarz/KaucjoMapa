{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@/*": ["./src/*"],
      "@layouts/*": ["./src/layouts/*"],
			"@features/*": ["./src/features/*"],
			"@shared/*": ["./src/shared/*"]
		}
	},
	"include": [".astro/types.d.ts", ".astro/env.d.ts", "src/**/*", "tests/**/*", "*.config.*"],
	"exclude": ["dist", "node_modules"]
}
