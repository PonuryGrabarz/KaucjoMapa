{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@layouts/*": [
        "./src/shared/layouts/*"
      ],
      "@components/*": [
        "./src/shared/components/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@api/*": [
        "./src/shared/api/*"
      ],
    }
  }
}
