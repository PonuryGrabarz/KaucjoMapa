{
  "name": "kaucjomapa",
  "version": "0.0.0",
  "private": true,
  "description": "Aplikacja webowa do wyszukiwania punktów zwrotu opakowań kaucyjnych",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "frontend:dev": "bun --cwd frontend dev",
    "frontend:build": "bun --cwd frontend build",
    "frontend:check": "bun --cwd frontend check",
    "frontend:lint": "bun --cwd frontend lint",
    "frontend:format": "bun --cwd frontend format",
    "frontend:format:check": "bun --cwd frontend format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
