{
    "swagger": "2.0",
    "info": {
        "description": "To jest serwer API dla aplikacji KaucjoMapa.",
        "title": "KaucjoMapa API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Wsparcie Techniczne",
            "email": "support@kaucjomapa.pl"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Zwraca prostą wiadomość potwierdzającą, że API działa.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Sprawdzenie działania API",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/kaucjomaty": {
            "get": {
                "description": "Zwraca punkty zwrotu do wyświetlenia na mapie.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "kaucjomaty"
                ],
                "summary": "Lista kaucjomatów",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/server.MapPoint"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "server.MapPoint": {
            "type": "object",
            "properties": {
                "bg_color": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                },
                "return_point_id": {
                    "type": "string"
                },
                "short_name": {
                    "type": "string"
                },
                "text_color": {
                    "type": "string"
                }
            }
        }
    }
}